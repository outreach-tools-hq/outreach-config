{
  "version": 2,
  "updated": "2026-10-13",
  "selectors": {
    "heading": "main h1, main h2",
    "stickyBar": "[role=\"toolbar\"]",
    "connectLink": "a[href*=\"custom-invite/\"]",
    "pending": "main [aria-label^=\"Pending, click to withdraw\"]",
    "noteBox": "textarea#custom-message, textarea[name=\"message\"]",
    "emailBox": "input[type=\"email\"][name=\"email\"]",
    "dialog": "[role=\"dialog\"], dialog, .artdeco-modal",
    "notices": "[role=\"dialog\"], dialog, .artdeco-modal, [role=\"alert\"], .artdeco-toast-item",
    "moreButton": {
      "regex": "^More( actions)?$",
      "flags": "i"
    },
    "addNoteButton": {
      "regex": "add a note",
      "flags": "i"
    },
    "sendButton": {
      "regex": "send invitation",
      "flags": "i"
    },
    "dismissButton": {
      "regex": "^Dismiss$",
      "flags": "i"
    },
    "discardButton": {
      "regex": "^Discard",
      "flags": "i"
    },
    "resultLink": "main a[href*=\"/in/\"]",
    "resultDegree": {
      "regex": "•\\s*(1st|2nd|3rd\\+?)",
      "flags": ""
    },
    "resultAction": {
      "regex": "^Invite .+ to connect$|^Send a message|^Pending|^Follow ",
      "flags": ""
    },
    "resultPending": {
      "regex": "^Pending",
      "flags": ""
    },
    "noResultsText": {
      "regex": "No results found",
      "flags": "i"
    },
    "sentInvitesUrl": "https://www.linkedin.com/mynetwork/invitation-manager/sent/",
    "sentCard": "[role=\"listitem\"]",
    "withdrawButton": {
      "regex": "^Withdraw",
      "flags": "i"
    },
    "withdrawLabelPrefix": {
      "regex": "^Withdraw invitation sent to\\s*",
      "flags": "i"
    },
    "withdrawConfirm": {
      "regex": "^Withdraw$",
      "flags": "i"
    },
    "loadMoreButton": {
      "regex": "^(Load|Show|See) more",
      "flags": "i"
    },
    "connectionsUrl": "https://www.linkedin.com/mynetwork/invite-connect/connections/",
    "messageButton": {
      "regex": "^Message\\b",
      "flags": "i"
    },
    "messageBox": ".msg-form__contenteditable, div[role=\"textbox\"][contenteditable=\"true\"]",
    "messageSendButton": {
      "regex": "^Send$",
      "flags": "i"
    },
    "messageItem": ".msg-s-event-listitem, .msg-s-message-list__event",
    "messageCloseButton": {
      "regex": "^Close your (conversation|draft)",
      "flags": "i"
    },
    "limitText": {
      "regex": "invitation limit|personali[sz]ed invitations",
      "flags": "i"
    },
    "degree": {
      "regex": "^·?\\s*(1st|2nd|3rd\\+?)$",
      "flags": ""
    },
    "blockedPaths": [
      "/checkpoint",
      "/login",
      "/authwall",
      "/uas/"
    ]
  }
}
